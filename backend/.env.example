# ==== Ambiente ====
ENVIRONMENT=development            # development | test | production

# ==== Banco de dados (Supabase PostgreSQL) ====
# Supabase > Project Settings > Database > Connection string (URI). Troque o prefixo por postgresql+psycopg://
# Em desenvolvimento sem Supabase, pode usar SQLite: sqlite:///./rifa_dev.db
DATABASE_URL=postgresql+psycopg://postgres:SENHA@db.SEU-PROJETO.supabase.co:5432/postgres

# ==== URLs ====
PUBLIC_BASE_URL=http://localhost:8000      # em produção: https://api.seudominio.com.br (usada no notification_url do Pix)
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# ==== Supabase Auth (painel /admin) ====
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Projetos com chave JWT legada (HS256): Settings > API > JWT Secret.
# Projetos com chaves assimétricas: deixe vazio — a validação usa o JWKS de SUPABASE_URL.
SUPABASE_JWT_SECRET=

# ==== Pagamentos ====
# manual_pix        -> Pix direto na chave do organizador; ele confirma cada pagamento no painel (uso real)
# simulator         -> simulador local, sem Mercado Pago (padrão para desenvolvimento)
# mercadopago_test  -> credenciais de TESTE do Mercado Pago (sem dinheiro real)
# mercadopago_live  -> BLOQUEADO até verificar a autorização legal e a aceitação pelo Mercado Pago
PAYMENT_MODE=simulator
MP_ACCESS_TOKEN=                    # Access Token de teste (Suas integrações > Credenciais de teste)
MP_WEBHOOK_SECRET=                  # Suas integrações > Webhooks > Assinatura secreta
# Somente para mercadopago_live, e somente após a regularização:
# LIVE_PAYMENTS_ACKNOWLEDGEMENT=AUTORIZACAO_LEGAL_E_MERCADO_PAGO_VERIFICADAS
PAYER_CPF_REQUIRED=true

# ==== Prazos ====
CHECKOUT_WINDOW_MINUTES=15          # contador visual
PIX_EXPIRATION_MINUTES=30           # vencimento enviado ao Mercado Pago (mínimo 30)
MANUAL_HOLD_MINUTES=1440            # modo manual: tempo que os números ficam reservados (24 h)
# Aviso no celular a cada reserva (app ntfy, grátis, iPhone e Android). Vazio = desligado.
# O tópico funciona como senha: use algo longo e aleatório, ex.: rifa-3f9a1c7e5b2d48a6
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh

# ==== Limites ====
MAX_NUMBERS_PER_ORDER=50
MAX_PENDING_ORDERS_PER_CONTACT=2
ORDER_RATE_LIMIT_PER_10MIN=8

# ==== Conciliação ====
RUN_BACKGROUND_RECONCILER=true
RECONCILE_INTERVAL_SECONDS=30
