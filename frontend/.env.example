# URL da API FastAPI. Em desenvolvimento, deixe vazio: o Vite encaminha /api para localhost:8000.
VITE_API_URL=
# Supabase (Realtime de disponibilidade e login do painel). Use SOMENTE a chave pública "anon".
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Permite colar um token de desenvolvimento no /admin quando o Supabase não está configurado.
VITE_ALLOW_DEV_TOKEN=true
